# StockSense Backend Environment Variables
# Copy to .env and fill in real values

# Database (Neon PostgreSQL — async driver prefix for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://user:password@host/stocksense?ssl=require

# JWT
SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
