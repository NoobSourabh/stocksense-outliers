# StockSense Backend Environment Variables
# Copy to .env and fill in real values

# Database (PostgreSQL / Neon)
# Async driver prefix 'postgresql+asyncpg://' is automatically handled by the app.
# If using Neon, use the pooled connection string with ssl=require.
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-example-pooler.region.aws.neon.tech/stocksense?ssl=require

# JWT Authentication
SECRET_KEY=generate-a-strong-random-64-character-secret-key-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# CORS (comma-separated origins)
# Include your frontend production URL (e.g. Vercel) alongside local development origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://stocksense.vercel.app

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Deployment / Seeding Options
# Set RUN_SEED=true to seed initial demo accounts (Maya/Arjun) and catalog data on startup
RUN_SEED=false
